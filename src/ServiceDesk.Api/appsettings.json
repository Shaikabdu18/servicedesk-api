{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=servicedesk.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "Seed": true
  },
  "Jwt": {
    "Issuer": "ServiceDesk",
    "Audience": "ServiceDesk.Clients",
    "SigningKey": "dev-only-signing-key-replace-in-production-0123456789",
    "ExpiryMinutes": 60
  }
}
